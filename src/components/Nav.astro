---
import { navLinks, isActive } from "./links";
import LogoMark from "./LogoMark.astro";
const path = Astro.url.pathname;
---

<nav class="nav" aria-label="Navigasi utama">
  <div class="nav-inner">
    <a href="/" class="nav-mark" aria-label="UNSCOPED - Home">
      <LogoMark size={22} />
      <span>UNSCOPED</span>
    </a>

    <ul class="nav-links" id="nav-links">
      {navLinks.map((l) => (
        <li>
          <a
            href={l.href}
            data-i18n={l.i18nKey}
            aria-current={isActive(l.href, path) ? "page" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="nav-links-mobile-cta">
        <a
          href="/play/"
          data-i18n="nav.play"
          aria-current={isActive("/play/", path) ? "page" : undefined}
        >
          Play Now
        </a>
      </li>
    </ul>

    <div class="nav-actions">
      <a href="/play/" class="nav-cta" data-i18n="nav.play">Play Now</a>

      <div class="lang-switch" role="group" aria-label="Pilih Bahasa / Select Language">
        <button
          type="button"
          class="lang-btn is-active"
          data-lang-btn="id"
          aria-pressed="true"
          title="Bahasa Indonesia"
        >
          ID
        </button>
        <span class="lang-divider" aria-hidden="true">/</span>
        <button
          type="button"
          class="lang-btn"
          data-lang-btn="en"
          aria-pressed="false"
          title="English"
        >
          EN
        </button>
      </div>

      <button
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-links"
        aria-label="Buka menu"
        data-i18n="nav.menu"
      >
        MENU
      </button>
    </div>
  </div>
</nav>
