---
interface Props {
  size?: number;
  class?: string;
  theme?: "current" | "light" | "dark";
}

const { size = 24, class: className = "", theme = "current" } = Astro.props;

const strokeColor =
  theme === "dark"
    ? "#0A0E12"
    : theme === "light"
      ? "#ECEAE4"
      : "currentColor";
---

<svg
  class={`logo-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <g stroke={strokeColor} stroke-width="4.5" stroke-linecap="square">
    <path d="M52.74 35.29A21 21 0 0 1 35.29 52.74"></path>
    <path d="M28.71 52.74A21 21 0 0 1 11.26 35.29"></path>
    <path d="M11.26 28.71A21 21 0 0 1 28.71 11.26"></path>
    <line x1="32" y1="41" x2="32" y2="47"></line>
    <line x1="41" y1="32" x2="47" y2="32"></line>
    <line x1="32" y1="23" x2="32" y2="17"></line>
    <line x1="23" y1="32" x2="17" y2="32"></line>
  </g>
  <rect
    x="28.4"
    y="28.4"
    width="7.2"
    height="7.2"
    fill="#FF4655"
    transform="rotate(45 32 32)"
  ></rect>
</svg>
